BIYOU_ENVIRONMENT=development
BIYOU_LOG_LEVEL=INFO
BIYOU_LOG_FORMAT=json
BIYOU_DATABASE_PATH=../data/biyou.db
BIYOU_LLM_PROVIDER=openai_compatible
BIYOU_LLM_API_KEY=
BIYOU_LLM_BASE_URL=https://api.siliconflow.cn/v1
BIYOU_LLM_MODEL=Pro/zai-org/GLM-4.7
BIYOU_LLM_TIMEOUT_SECONDS=120
BIYOU_LLM_MAX_TOKENS=2048
BIYOU_LLM_TEMPERATURE=0.2
BIYOU_INTENT_CLASSIFIER_ENABLED=true
# 留空时复用 BIYOU_LLM_MODEL；也可配置更轻量的兼容模型降低路由延迟。
BIYOU_INTENT_MODEL=
BIYOU_INTENT_TIMEOUT_SECONDS=8
BIYOU_INTENT_MAX_TOKENS=256
BIYOU_INTENT_CONFIDENCE_THRESHOLD=0.65
BIYOU_RAG_TOP_K=5
BIYOU_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
